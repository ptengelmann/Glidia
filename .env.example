# ---- Core ----
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/Glidia

# ---- Shopify App (OAuth) ----
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here
